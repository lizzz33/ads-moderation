# MLflow
USE_MLFLOW=true
MLFLOW_HOST=localhost
MLFLOW_PORT=5000
MLFLOW_EXPERIMENT_NAME=moderation-model-1
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_DEFAULT_ARTIFACT_ROOT=./mlruns

# Database (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moderation
PG_DSN=postgresql://postgres:postgres@localhost:5432/moderation

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Kafka
KAFKA_BOOTSTRAP=localhost:9092
TOPIC=moderation
DLQ_TOPIC=moderation_dlq
CONSUMER_GROUP=moderation-worker

# API
API_PORT=8003

# Retry Settings
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5

# JWT Auth
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
